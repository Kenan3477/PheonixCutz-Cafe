# Optional. Overrides the built-in chair diary password.
BOOKING_ADMIN_PASSWORD=

# Optional. Used to sign Yusuf’s diary cookie.
BOOKING_SECRET=

# Railway Redis — keeps the diary after deploys. Use the public REDIS_URL,
# not the *.railway.internal one (that only works if the app is on Railway too).
REDIS_URL=

# Optional fallback: Vercel KV or Upstash REST
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
